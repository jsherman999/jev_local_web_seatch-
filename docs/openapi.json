  "components": {
    "schemas": {
      "BrowserResult": {
        "properties": {
          "agent_status": {
            "type": "string",
            "title": "Agent Status"
          },
          "verification": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_requested"
            ],
            "title": "Verification"
          },
          "checks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Checks"
          },
          "page": {
            "$ref": "#/components/schemas/PageResult"
          },
          "visited_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Visited Urls"
          },
          "steps": {
            "type": "integer",
            "title": "Steps"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "actions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Actions"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          }
        },
        "type": "object",
        "required": [
          "agent_status",
          "verification",
          "checks",
          "page",
          "visited_urls",
          "steps",
          "elapsed_ms",
          "actions"
        ],
        "title": "BrowserResult"
      },
      "CatalogRequest": {
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "openai",
                  "deepseek",
                  "groq",
                  "openrouter",
                  "google",
                  "anthropic"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CatalogRequest"
      },
      "ComparisonRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url",
            "description": "Starting HTTP(S) URL. No file or javascript URLs."
          },
          "goal": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Goal",
            "description": "One natural-language browser task."
          },
          "max_steps": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 25
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 5.0,
            "title": "Timeout Seconds",
            "description": "Execution limit, excluding queue time.",
            "default": 120
          },
          "max_text_chars": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Max Text Chars",
            "default": 30000
          },
          "capture_screenshots": {
            "type": "boolean",
            "title": "Capture Screenshots",
            "description": "Capture browser previews after decisions.",
            "default": false
          },
          "isolate_browser": {
            "type": "boolean",
            "title": "Isolate Browser",
            "description": "Use a fresh browser context for this job.",
            "default": false
          },
          "verify": {
            "$ref": "#/components/schemas/Verification"
          },
          "llm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LLMChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_rates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rates"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "goal"
        ],
        "title": "ComparisonRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "blocked",
              "failed",
              "timed_out",
              "cancelled",
              "interrupted"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "request": {
            "$ref": "#/components/schemas/JobRequest"
          },
          "progress": {
            "additionalProperties": true,
            "type": "object",
            "title": "Progress"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BrowserResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "updated_at",
          "request"
        ],
        "title": "Job"
      },
      "JobRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url",
            "description": "Starting HTTP(S) URL. No file or javascript URLs."
          },
          "goal": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Goal",
            "description": "One natural-language browser task."
          },
          "max_steps": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 25
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 5.0,
            "title": "Timeout Seconds",
            "description": "Execution limit, excluding queue time.",
            "default": 120
          },
          "max_text_chars": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Max Text Chars",
            "default": 30000
          },
          "capture_screenshots": {
            "type": "boolean",
            "title": "Capture Screenshots",
            "description": "Capture browser previews after decisions.",
            "default": false
          },
          "isolate_browser": {
            "type": "boolean",
            "title": "Isolate Browser",
            "description": "Use a fresh browser context for this job.",
            "default": false
          },
          "verify": {
            "$ref": "#/components/schemas/Verification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "goal"
        ],
        "title": "JobRequest"
      },
      "LLMChoice": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "deepseek",
              "groq",
              "openrouter",
              "google",
              "anthropic"
            ],
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[\\w./:+-]+$",
            "title": "Model"
          },
          "rates": {
            "$ref": "#/components/schemas/Rates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "LLMChoice"
      },
      "PageResult": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "text_truncated": {
            "type": "boolean",
            "title": "Text Truncated"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/SourceLink"
            },
            "type": "array",
            "title": "Links"
          },
          "links_truncated": {
            "type": "boolean",
            "title": "Links Truncated",
            "default": false
          },
          "captured_at": {
            "type": "string",
            "title": "Captured At"
          }
        },
        "type": "object",
        "required": [
          "url",
          "title",
          "text",
          "text_truncated",
          "links",
          "captured_at"
        ],
        "title": "PageResult"
      },
      "Rates": {
        "properties": {
          "input": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Input"
          },
          "cached": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached"
          },
          "output": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Rates"
      },
      "SourceLink": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "text",
          "url"
        ],
        "title": "SourceLink"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "url_contains": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Url Contains"
          },
          "text_contains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Text Contains"
